APP_NAME=SIPANDU
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# Origin frontend yang diizinkan CORS (dipisah koma bila lebih dari satu)
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sipandu
DB_USERNAME=root
DB_PASSWORD=

# Koneksi khusus pengujian (phpunit.xml memakai DB_DATABASE_TEST)
DB_DATABASE_TEST=sipandu_test

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=sipandu

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@sipandu.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Kosong = token tidak kedaluwarsa (dicabut saat logout)
SANCTUM_TOKEN_EXPIRATION=
